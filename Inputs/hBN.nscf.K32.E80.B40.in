 &control
    calculation = 'nscf'
    restart_mode='from_scratch',
    prefix       = 'hBN'
    pseudo_dir   = 'PS'
    outdir       = 'outs'
    verbosity    = 'high'
    wf_collect   = .true.
    tprnfor      = .true.
 /
 &system    
    ibrav=  4 
    celldm(1) = 4.72431525 
    celldm(3) = 5.000
    nat=  2
    ntyp= 2
    ecutwfc = 80,
    nbnd = 40,
    force_symmorphic=.true.
 /
 &electrons
   diago_thr_init =  1.0d-7
 /
ATOMIC_SPECIES 
 B 1.0  B.pz-vbc.UPF     
 N 1.0  N.pz-vbc.UPF 
ATOMIC_POSITIONS crystal 
 B     6.6666666666E-01  3.3333333333E-01  0.000000000E+00
 N     -6.6666666666E-01 -3.3333333333E-01 0.000000000E+00
K_POINTS automatic
 32 32 1 0 0 0
